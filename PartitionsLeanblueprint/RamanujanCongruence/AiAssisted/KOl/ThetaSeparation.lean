import PartitionsLeanblueprint.RamanujanCongruence.AiAssisted.KOl.WeightSeparation

/-!
Separation of the components of a Fourier-series identity by weight.  The
input is the Swinnerton-Dyer description of the kernel of evaluation as the
ideal generated by the Hasse relation.
-/

namespace KOl

open scoped IntegerModularForm
open PIntegralModularForm.SwD

noncomputable section

variable {ell : ℕ} [isLargePrime ell]

private theorem hasseIdeal_le_graded_kernel :
    hasseIdeal (p := ell) ≤ RingHom.ker (polynomialToGradedForms (p := ell)) := by
  classical
  let hasseWeighted : ResidueWeightedPolynomial (p := ell) 0 :=
    { polynomial := Abar (p := ell)
      homogeneous := by
        intro n hn
        have hn' : n ∈
            (PIntegralModularForm.polynomial (p := ell)
              (normalizedEisMinusOne (p := ell))).support := by
          exact MvPolynomial.support_map_subset
            (f := PIntegralModularForm.coeffToZMod (p := ell))
            (PIntegralModularForm.polynomial (p := ell)
              (normalizedEisMinusOne (p := ell)))
            (by simpa [Abar, A, reducePolynomial] using hn)
        have hdegree := PIntegralModularForm.polynomial_isHomogeneous
          (p := ell) (normalizedEisMinusOne (p := ell)) hn'
        have hmod : (((ell : ℤ) - 1 : ℤ) : ZMod (ell - 1)) = 0 := by
          apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).2
          have hle : 1 ≤ ell := by
            have := (inferInstance : isLargePrime ell).AtLeastFive
            omega
          rw [Nat.cast_sub hle]
          exact dvd_refl _
        exact (congrArg (fun z : ℤ => (z : ZMod (ell - 1))) hdegree).trans hmod }
  obtain ⟨g, hg, hgfourier⟩ :=
    polynomialToGradedForms_weighted_fourier (p := ell) hasseWeighted
  have hgone : g = 1 := by
    apply ModularFormMod.fourier_inj
    rw [hgfourier, show hasseWeighted.polynomial = Abar from rfl, evaluate_Abar]
    simp [ModularFormMod.one_def]
  have hAbar : polynomialToGradedForms (p := ell) (Abar (p := ell)) = 1 := by
    rw [show Abar = hasseWeighted.polynomial from rfl, hg, hgone]
    exact DirectSum.of_zero_one (fun j : ZMod (ell - 1) => ModularFormMod ell j)
  rw [hasseIdeal]
  refine Ideal.span_le.2 ?_
  intro x hx
  obtain rfl := Set.mem_singleton_iff.mp hx
  change polynomialToGradedForms (p := ell) (Abar (p := ell) - 1) = 0
  rw [map_sub, hAbar, map_one, sub_self]

/-- A vanishing finite sum of Fourier expansions also vanishes in the
direct sum of the modular-form weight spaces. -/
theorem graded_sum_eq_zero_of_fourier_sum_eq_zero {ι : Type*}
    (s : Finset ι) (w : ι → ZMod (ell - 1))
    (f : ∀ i, ModularFormMod ell (w i))
    (h : ∑ i ∈ s, (f i).fourier = 0) :
    ∑ i ∈ s, DirectSum.of (fun j => ModularFormMod ell j) (w i) (f i) = 0 := by
  classical
  choose P hP using fun i => exists_weighted_representation (p := ell) (f i)
  have hgraded (i : ι) : polynomialToGradedForms (p := ell) (P i).polynomial =
      DirectSum.of (fun j => ModularFormMod ell j) (w i) (f i) := by
    obtain ⟨g, hg, hgf⟩ := polynomialToGradedForms_weighted_fourier (P i)
    rw [hg]
    congr 1
    exact ModularFormMod.fourier_inj (hgf.trans (hP i))
  have heval : Malgebra.evaluate (p := ell) (∑ i ∈ s, (P i).polynomial) = 0 := by
    apply Subtype.ext
    change evaluateResiduePolynomial (p := ell) (∑ i ∈ s, (P i).polynomial) = 0
    simpa only [map_sum, hP] using h
  have hker : (∑ i ∈ s, (P i).polynomial) ∈ hasseIdeal (p := ell) := by
    rw [← Ker_eq_hasseIdeal]
    exact heval
  have hz := hasseIdeal_le_graded_kernel (ell := ell) hker
  change polynomialToGradedForms (p := ell) (∑ i ∈ s, (P i).polynomial) = 0 at hz
  simpa only [map_sum, hgraded] using hz

/-- Each weight component of a vanishing Fourier-series sum vanishes. -/
theorem fourier_sum_weight_fiber_eq_zero {ι : Type*}
    (s : Finset ι) (w : ι → ZMod (ell - 1))
    (f : ∀ i, ModularFormMod ell (w i)) (j : ZMod (ell - 1))
    (h : ∑ i ∈ s, (f i).fourier = 0) :
    ∑ i ∈ s with w i = j, (f i).fourier = 0 := by
  classical
  have hg := graded_sum_eq_zero_of_fourier_sum_eq_zero s w f h
  have hc := congrArg (fun g : DirectSum _ (fun j => ModularFormMod ell j) =>
    (g j).fourier) hg
  rw [DirectSum.sum_apply] at hc
  change (ModularFormMod.fourierAddHom (ℓ := ell))
    (∑ i ∈ s, (DirectSum.of (fun j => ModularFormMod ell j) (w i) (f i)) j) = 0 at hc
  rw [map_sum] at hc
  rw [Finset.sum_filter]
  convert hc using 1
  apply Finset.sum_congr rfl
  intro i hi
  by_cases hw : w i = j
  · subst j
    simp only [if_pos rfl, DirectSum.of_eq_same]
    rfl
  · rw [if_neg hw, DirectSum.of_eq_of_ne _ _ _ (Ne.symm hw)]
    rfl

/-- Multiplication by a nonzero residue does not change filtration. -/
theorem filtration_smul_eq {k : ZMod (ell - 1)}
    (f : ModularFormMod ell k) (a : ZMod ell) (ha : a ≠ 0) :
    (a • f).Filtration = f.Filtration := by
  have scale {j : ℤ} (g : ModularFormMod ell k) (b : ZMod ell)
      (hj : g.hasWeight j) : (b • g).hasWeight j := by
    obtain ⟨G, hG⟩ := hj.exists_reduce
    refine ⟨b.val • G, ?_⟩
    change PowerSeries.map (Int.castRingHom (ZMod ell))
      (b.val • G.fourier) = b • g.fourier
    rw [map_nsmul, ← Nat.cast_smul_eq_nsmul (ZMod ell), ZMod.natCast_zmod_val, hG]
    rfl
  apply ModularFormMod.Filtration_ext'
  intro j
  constructor
  · intro h
    have h' := scale (a • f) a⁻¹ h
    simpa [smul_smul, ha] using h'
  · exact scale f a

private lemma theta_weight_fiber {k : ZMod (ell - 1)}
    (h : ℕ) (hhalf : ell - 1 = 2 * h) (hhpos : 0 < h)
    {i j : ℕ} (hi : 1 ≤ i) (hilt : i ≤ ell - 1)
    (hj : 1 ≤ j) (hjle : j ≤ h) :
    k + i • (2 : ZMod (ell - 1)) = k + j • 2 ↔ i = j ∨ i = j + h := by
  constructor
  · intro hw
    have hc : ((2 * i : ℤ) : ZMod (ell - 1)) = ((2 * j : ℤ) : ZMod (ell - 1)) := by
      simpa [nsmul_eq_mul, mul_comm] using add_left_cancel hw
    have hd := (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ _).mp hc
    obtain ⟨t, ht⟩ := hd
    have hhalfInt : ((ell - 1 : ℕ) : ℤ) = 2 * (h : ℤ) := by exact_mod_cast hhalf
    rw [hhalfInt] at ht
    have hdiff : (i : ℤ) - j = (h : ℤ) * (-t) := by nlinarith [ht]
    have htlo : 0 ≤ -t := by
      by_contra hneg
      have : -t ≤ -1 := by omega
      nlinarith
    have hthi : -t ≤ 1 := by
      by_contra hgt
      have : 2 ≤ -t := by omega
      have hiupper : i ≤ 2 * h := by omega
      nlinarith
    have hcases : t = -1 ∨ t = 0 := by omega
    rcases hcases with rfl | rfl
    · right
      norm_num at hdiff
      omega
    · left
      norm_num at hdiff
      omega
  · rintro (rfl | rfl)
    · rfl
    · have hz : h • (2 : ZMod (ell - 1)) = 0 := by
        calc
          h • (2 : ZMod (ell - 1)) = ((2 * h : ℕ) : ZMod (ell - 1)) := by
            simp [nsmul_eq_mul, mul_comm]
          _ = 0 := by rw [← hhalf]; exact ZMod.natCast_self _
      rw [add_nsmul, hz, add_zero]

/-- A congruence at a nonzero residue makes the filtration repeat halfway
around the theta cycle. This is the direct-sum step of Proposition 3. -/
theorem theta_half_cycle_filtration {k : ZMod (ell - 1)}
    (f : ModularFormMod ell k) (a : ZMod ell) (ha : a ≠ 0)
    (hidentity : ∀ n : ℕ,
      (((n : ZMod ell) - a) ^ (ell - 1)) * f.coeff n = f.coeff n)
    {j : ℕ} (hj : 1 ≤ j) (hjle : j ≤ (ell - 1) / 2) :
    (f.Theta_pow j).Filtration =
      (f.Theta_pow (j + (ell - 1) / 2)).Filtration := by
  classical
  let h := (ell - 1) / 2
  have hlarge := (inferInstance : isLargePrime ell).AtLeastFive
  have hodd : Odd ell :=
    (Nat.Prime.odd_iff (inferInstance : isLargePrime ell).Prime).mpr (by omega)
  have hhalf : ell - 1 = 2 * h := by
    obtain ⟨t, ht⟩ := hodd
    have heven : 2 ∣ ell - 1 := ⟨t, by omega⟩
    exact (Nat.mul_div_cancel' heven).symm
  have hhpos : 0 < h := by omega
  let c : ℕ → ZMod ell := fun i => (-1) ^ i * (-a) ^ (ell - 1 - i)
  let T := fun i => c i • f.Theta_pow i
  have hcne (i : ℕ) : c i ≠ 0 := by
    exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
      (pow_ne_zero _ (neg_ne_zero.mpr ha))
  have hc0 : c 0 = 1 := by
    simp only [c, pow_zero, one_mul, Nat.sub_zero]
    exact ZMod.pow_card_sub_one_eq_one (neg_ne_zero.mpr ha)
  have hsum : ∑ i ∈ Finset.Icc 1 (ell - 1), (T i).fourier = 0 := by
    apply PowerSeries.ext
    intro n
    have hbin := prime_theta_binomial_coeff f a.val n
    rw [ZMod.natCast_zmod_val] at hbin
    have hsplit : Finset.range ell = insert 0 (Finset.Icc 1 (ell - 1)) := by
      ext i
      simp only [Finset.mem_range, Finset.mem_insert, Finset.mem_Icc]
      omega
    rw [hsplit, Finset.sum_insert (by simp)] at hbin
    have hterm (i : ℕ) :
        (-1 : ZMod ell) ^ i * (f.Theta_pow i).coeff n *
          (-a) ^ (ell - 1 - i) = (T i).coeff n := by
      simp only [T, c, map_smul, smul_eq_mul]
      ring
    simp_rw [hterm] at hbin
    have hz0 : (T 0).coeff n = f.coeff n := by
      simp only [T, hc0, one_smul, ModularFormMod.Theta_pow_zero,
        ModularFormMod.coeff_Mcast]
    have hbin' : f.coeff n = f.coeff n +
        ∑ i ∈ Finset.Icc 1 (ell - 1), (T i).coeff n := by
      rwa [hidentity n, hz0] at hbin
    have hz : ∑ i ∈ Finset.Icc 1 (ell - 1), (T i).coeff n = 0 := by
      exact add_left_cancel (hbin'.symm.trans (add_zero _).symm)
    simpa only [map_sum, ModularFormMod.coeff_def, map_zero] using hz
  have hcomponent := fourier_sum_weight_fiber_eq_zero
    (Finset.Icc 1 (ell - 1)) (fun i => k + i • 2) T (k + j • 2) hsum
  have hfiber : (Finset.Icc 1 (ell - 1)).filter
      (fun i => k + i • (2 : ZMod (ell - 1)) = k + j • 2) = {j, j + h} := by
    ext i
    simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_insert,
      Finset.mem_singleton]
    constructor
    · rintro ⟨⟨hi, hilt⟩, hw⟩
      exact (theta_weight_fiber h hhalf hhpos hi hilt hj hjle).1 hw
    · intro hi
      have hi' : 1 ≤ i ∧ i ≤ ell - 1 := by rcases hi with rfl | rfl <;> omega
      exact ⟨hi', (theta_weight_fiber h hhalf hhpos hi'.1 hi'.2 hj hjle).2 hi⟩
  rw [hfiber, Finset.sum_pair (by omega : j ≠ j + h)] at hcomponent
  have hfourier : (T j).fourier = (-(T (j + h))).fourier := by
    rw [ModularFormMod.fourier_neg]
    exact eq_neg_of_add_eq_zero_left hcomponent
  have hfil : (T j).Filtration = (-(T (j + h))).Filtration := by
    apply ModularFormMod.Filtration_ext
    intro n
    exact congrArg (fun q : PowerSeries (ZMod ell) => q.coeff n) hfourier
  simpa only [T, ModularFormMod.Filtration_neg,
    filtration_smul_eq _ _ (hcne _)] using hfil

end
end KOl
