import PartitionsLeanblueprint.RamanujanCongruence.AiAssisted.SwD.MAlgebra
import PartitionsLeanblueprint.RamanujanCongruence.AiAssisted.SwD.AbarSubOne
import Mathlib.RingTheory.Jacobson.Ring
